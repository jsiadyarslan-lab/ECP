{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecp-protocol.org/0.1.0/system.schema.json",
  "title": "ECP System Identity",
  "description": "Versioned identity of an evaluation target. A bare model name is NEVER a complete system identity: even a model-only evaluation must pin model, provider, model version and API version; a complete-system evaluation must additionally pin configuration (system prompt, agent framework, tools, retrieval, external services), runtime and adapter. The target is a versioned system configuration, not a model name. Provider-specific integration lives OUTSIDE the protocol core.",
  "type": "object",
  "required": [
    "ecp_object",
    "system_id",
    "system_version",
    "identity_mode",
    "model",
    "protocol_version",
    "case_set_version"
  ],
  "properties": {
    "ecp_object": { "const": "system" },
    "system_id": {
      "type": "string",
      "pattern": "^ECP-SYSTEM-[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "system_version": { "$ref": "#/$defs/semver" },
    "identity_mode": {
      "enum": ["model-only", "complete-system"],
      "description": "model-only: bare model accessed directly (no configuration). complete-system: model + configuration + runtime + adapter."
    },
    "model": {
      "type": "object",
      "required": ["name", "provider", "model_version", "api_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "api_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the access API/contract used to invoke the model (e.g. 'chat-completions-v1', 'local-cli-v2')."
        },
        "endpoint_kind": { "enum": ["cloud", "local", "bundled", "undisclosed"] }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "description": "Present only for complete-system targets. All five components must be declared; empty arrays / null express explicit absence.",
      "required": ["system_prompt", "agent_framework", "tools", "retrieval", "external_services"],
      "properties": {
        "system_prompt": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "The system prompt, verbatim; null declares explicit absence."
        },
        "agent_framework": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool_id", "tool_version"],
            "properties": {
              "tool_id": { "type": "string", "minLength": 1 },
              "tool_version": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "retrieval": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "external_services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service_id", "service_version"],
            "properties": {
              "service_id": { "type": "string", "minLength": 1 },
              "service_version": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["adapter_id", "adapter_version"],
      "properties": {
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["environment", "runtime_version"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "protocol_version": { "$ref": "#/$defs/semver" },
    "schema_version": { "$ref": "#/$defs/semver" },
    "case_set_version": {
      "$ref": "#/$defs/semver",
      "description": "Version of the case set this system identity is declared against."
    },
    "description": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "identity_mode": { "const": "model-only" } },
        "required": ["identity_mode"]
      },
      "then": {
        "not": { "required": ["configuration"] },
        "description": "A model-only target must not declare a configuration block."
      }
    },
    {
      "if": {
        "properties": { "identity_mode": { "const": "complete-system" } },
        "required": ["identity_mode"]
      },
      "then": { "required": ["configuration", "runtime", "adapter"] }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
