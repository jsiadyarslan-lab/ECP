{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ecp-protocol.org/0.8.0/provider.schema.json",
  "title": "ECP Provider Metadata",
  "description": "Provider-neutral metadata for an external interface. No credentials or provider execution behavior are represented.",
  "type": "object",
  "required": ["ecp_object", "provider_id", "provider_version", "interfaces", "status"],
  "properties": {
    "ecp_object": { "const": "provider" },
    "provider_id": { "type": "string", "pattern": "^ECP-PROVIDER-[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "provider_version": { "$ref": "#/$defs/semver" },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["active", "inactive", "deprecated"] },
    "description": { "type": "string" }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
